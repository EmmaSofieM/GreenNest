---
import "../base.css";
import Header from "../components/Header.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>GreenNest</title>

		<!-- primary favicon (SVG ok for supporting browsers) -->
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

		<!-- fallback/compat (PNG) -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

		<!-- apple / android -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- safari pinned tab -->
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#122D12" />

		<!-- fallback meta -->
		<meta name="theme-color" content="#FAFCF7" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Hind:wght@300;400;500;600;700&family=Lora:ital,wght@0,400..700;1,400..700&family=Press+Start+2P&family=Quicksand:wght@300..700&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	body {
  margin: 0;
  width: 100%;
  min-height: 100vh; /* sørger for at siden kan scrolles */
}

	
</style>
