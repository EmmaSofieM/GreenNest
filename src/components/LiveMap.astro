---
<!-- Leaflet + MarkerCluster CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

<style global>
  :root {
    --map-max-width: 1200px;
    --map-height: 70vh;
  }

  .map-wrap {
    width: 100%;
    max-width: var(--map-max-width);
    margin: 32px auto;
    position: relative;
  }

  #map {
    width: 100%;
    height: var(--map-height);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 30px rgba(6,20,8,0.06);
  }

  /* loading indicator */
  .map-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, rgba(255,255,255,0.3), rgba(255,255,255,0.0));
    z-index: 1100;
    pointer-events: none;
  }
  .map-loading .dot { width:10px; height:10px; background:#122d12; border-radius:50%; animation: ping 900ms infinite ease-in-out; }
  @keyframes ping { 0% { transform: scale(.6); opacity:.6 } 50% { transform: scale(1.3); opacity:1 } 100% { transform: scale(.6); opacity:.6 } }

  /* live temp card (inside wrapper, top-right) */
  #live-temp {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1200;
    background: rgba(255,255,255,0.95);
    color: #122d12;
    font-size: 0.95rem;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    padding: 0.55em 0.9em;
    border-radius: 10px;
    box-shadow: 0 8px 26px rgba(6,20,8,0.08);
    border: 1px solid rgba(139,197,63,0.18);
    pointer-events: auto;
  }

  /* popup styling overrides */
  .leaflet-popup-content-wrapper {
    background: rgba(211,250,145,0.85) !important;
    background-image: none !important;
    color: #122d12 !important;
  }
  .leaflet-popup-tip,
  .leaflet-popup-tip-container { background: rgba(211,250,145,0.85) !important; background-image: none !important; }
  .leaflet-popup-content { color: #122d12 !important; }

  /* zoom control visuals */
  .leaflet-control-zoom-in, .leaflet-control-zoom-out {
    background: #fff !important;
    color: #122d12 !important;
    border: 1px solid #b6e86d !important;
    border-radius: 50% !important;
    width: 34px !important;
    height: 34px !important;
    line-height: 30px !important;
    text-align: center;
    box-shadow: none !important;
  }
  .leaflet-control-zoom-in:hover, .leaflet-control-zoom-out:hover {
    background: #d3fa91 !important;
    border-color: #8fd14a !important;
  }

  /* responsive */
  @media (max-width: 900px) {
    :root { --map-height: 55vh; }
    #live-temp { right: 8px; left: auto; top: 8px; font-size:0.85rem; }
    .map-wrap { margin: 20px 12px; }
  }
</style>

<div class="map-wrap" aria-hidden="false">
  <div id="map" role="application" aria-label="Interactive map of Lisbon parks"></div>
  <div id="live-temp" aria-live="polite">Loading temperature...</div>
  <div class="map-loading" id="mapLoading" aria-hidden="true"><div class="dot"></div></div>
</div>

<!-- scripts loaded client-side -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" client:load></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js" client:load></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js" client:load></script>

<script client:load>
  // run only in browser
  (function () {
    if (typeof window === 'undefined') return;

    // wait until Leaflet is available
    function whenLeaflet(cb) {
      if (window.L && window.L.marker) return cb();
      const t = setInterval(() => { if (window.L && window.L.marker) { clearInterval(t); cb(); } }, 60);
      // timeout fallback
      setTimeout(() => { clearInterval(t); if (window.L && window.L.marker) cb(); }, 5000);
    }

    // small helper to escape user-provided text for popup
    function esc(s) {
      return String(s || '').replace(/[&<>"'`]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','`':'&#96;'})[c]);
    }

    whenLeaflet(initMap);

    function initMap() {
      const mapEl = document.getElementById('map');
      const loadingEl = document.getElementById('mapLoading');
      loadingEl.setAttribute('aria-hidden', 'false');

      // basic map
      const map = L.map(mapEl, { preferCanvas: true, zoomControl: true }).setView([38.716, -9.14], 13);

      // nice tile with retina support
      const tiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap & CartoDB',
        maxZoom: 19
      }).addTo(map);

      // constrain panning a bit around Lisbon
      const southWest = L.latLng(38.60, -9.40);
      const northEast = L.latLng(38.82, -8.95);
      map.setMaxBounds(L.latLngBounds(southWest, northEast));
      map.on('drag', () => map.panInsideBounds(map.getBounds(), { animate: false }));

      // icon paths - use explicit root paths so builds/hosting find them reliably
      const customIcon = L.icon({
        iconUrl: '/images/map/pinned.svg',
        iconSize: [34, 34],
        iconAnchor: [17, 34],
        popupAnchor: [0, -34]
      });

      const parksUrl = 'https://services.arcgis.com/1dSrzEWVQn5kHHyK/arcgis/rest/services/POIArLivre/FeatureServer/0/query?outFields=*&where=1%3D1&f=geojson';

      // marker cluster
      const clusterGroup = L.markerClusterGroup({ chunkedLoading: true, removeOutsideVisibleBounds: true });

      const heatPoints = [];

      fetch(parksUrl).then(res => {
        if (!res.ok) throw new Error('Park data fetch failed');
        return res.json();
      }).then(geojson => {
        // create GeoJSON layer with markers -> cluster
        L.geoJSON(geojson, {
          pointToLayer: (feature, latlng) => {
            return L.marker(latlng, { icon: customIcon });
          },
          onEachFeature: (feature, layer) => {
            const props = feature.properties || {};
            const parkName = esc(props.NOME || props.nome || props.name || 'Unknown park');
            const noise = Math.floor(40 + Math.random() * 30);
            const shade = ['Low','Medium','High'][Math.floor(Math.random()*3)];
            const tables = Math.random() > 0.5 ? 'Yes' : 'No';

            // detect dog-friendly / dog-park from common property names or fallback to heuristic
            const lowerProps = JSON.stringify(props).toLowerCase();
            const isDogPark = (
              props.DOGPARK === 'Yes' ||
              props.DOGPARK === 'Sim' ||
              props.ALLOWS_DOGS === true ||
              props.allows_dogs === true ||
              props.cães === 'Sim' ||
              /dog|cao|cachorro|cães|caes|canino|perros/.test(lowerProps)
            );
            
            const popupHtml = `
              <div style="text-align:right;min-width:180px;">
                <strong>${parkName}</strong>
                <div style="display:flex;gap:8px;align-items:center;margin-top:6px;">
                  <img src="/images/map/noise.svg" alt="" style="height:1.4em;opacity:.95;">
                  <span style="flex:1;text-align:right">Noise: ${noise} dB</span>
                </div>
                <div style="display:flex;gap:8px;align-items:center;margin-top:6px;">
                  <img src="/images/map/tree.svg" alt="" style="height:1.4em;opacity:.95;">
                  <span style="flex:1;text-align:right">Shade: ${esc(shade)}</span>
                </div>
                <div style="display:flex;gap:8px;align-items:center;margin-top:6px;">
                  <img src="${isDogPark ? '/images/map/dog.svg' : '/images/mapPhotos/bench.png'}" alt="" style="height:1.4em;opacity:.95;">
                  <span style="flex:1;text-align:right">${isDogPark ? 'Dog friendly' : `Tables: ${esc(tables)}`}</span>
                </div>
              </div>`;
            layer.bindPopup(popupHtml, { maxWidth: 260 });
            const coords = feature.geometry && feature.geometry.coordinates;
            if (coords && coords.length >= 2) {
              const temp = 20 + Math.random()*15;
              const intensity = Math.max(0, Math.min(1, (temp - 18)/12));
              heatPoints.push([coords[1], coords[0], intensity]);
            }
            clusterGroup.addLayer(layer);
          }
        });
        map.addLayer(clusterGroup);

        // heat layer only if we have points
        if (heatPoints.length) {
          L.heatLayer(heatPoints, { radius: 50, blur: 18, maxZoom: 17, gradient: {0.0:'blue',0.5:'lime',1.0:'red'} }).addTo(map);
        }

        // fit view to markers if available
        const bounds = clusterGroup.getBounds();
        if (bounds.isValid()) {
          map.fitBounds(bounds.pad(0.15), { maxZoom: 16, animate: true });
        }

      }).catch(err => {
        console.error('Parks load error', err);
      }).finally(() => {
        // hide loading once initial data attempt finished
        loadingEl.setAttribute('aria-hidden', 'true');
        loadingEl.style.display = 'none';
      });

      // live temperature panel
      const liveEl = document.getElementById('live-temp');
      function updateLiveTemp() {
        fetch('https://api.open-meteo.com/v1/forecast?latitude=38.716&longitude=-9.14&current_weather=true')
          .then(r => r.json())
          .then(data => {
            const w = data && data.current_weather;
            if (!w) { liveEl.textContent = 'Weather unavailable'; return; }
            const temp = w.temperature;
            const rainCodes = [51,53,55,61,63,65,80,81,82];
            const isRaining = rainCodes.includes(w.weathercode);
            const text = isRaining ? 'Rain' : 'Sunny';
            liveEl.innerHTML = `
              <div style="display:flex;align-items:center;gap:8px;">
                <img src="/images/map/hjem.svg" alt="" style="height:1.2em;">
                <strong style="margin-left:auto;">Lisbon</strong>
              </div>
              <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                <img src="/images/map/temp.svg" alt="" style="height:1.2em;">
                <span style="margin-left:auto;">${temp.toFixed(1)}°C</span>
              </div>
              <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                <img src="/images/map/${isRaining ? 'rain' : 'sun'}.svg" alt="" style="height:1.2em;">
                <span style="margin-left:auto;">${text}</span>
              </div>
            `;
          })
          .catch(() => { liveEl.textContent = 'Weather unavailable'; });
      }

      updateLiveTemp();
      setInterval(updateLiveTemp, 60000);

      // keep map responsive
      window.addEventListener('resize', () => { setTimeout(() => map.invalidateSize(), 250); });
    }
  })();
</script>
