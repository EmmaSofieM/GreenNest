---
---

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<style>
  body {
    margin: 0;
    padding: 0;
  }
  #map {
    width: 60vw;
    height: 50vh;
    margin: 40px auto;
  }

  /* dine custom styles */
  .leaflet-popup-content-wrapper {
    background: #d3fa91d4 !important;
    color: #122d12 !important;
  }
  .leaflet-popup-tip {
    background: #d3fa91d4 !important;
  }
  .leaflet-popup-content {
    color: #122d12 !important;
  }

  #live-temp {
    position: absolute;
    top: 50px;
    right: 22rem;
    z-index: 1000;
    background: #ffffffd4;
    color: #122d12;
    font-size: 1em;
    font-family: sans-serif;
    padding: 0.5em 1em;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
    border: 1px solid #b6e86d;
    letter-spacing: 0.5px;
    text-align: right;
  }

  .leaflet-control-zoom {
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    padding: 0;
    overflow: visible;
  }

  .leaflet-control-zoom-in,
  .leaflet-control-zoom-out {
    background: #fff !important;
    color: #122d12 !important;
    border: 1px solid #b6e86d !important;
    border-radius: 50% !important;
    font-size: 1.2em !important;
    height: 32px !important;
    width: 32px !important;
    line-height: 30px !important;
    margin: 4px 0;
    text-align: center;
    padding: 0;
    box-shadow: none !important;
  }
  .leaflet-control-zoom-in:hover,
  .leaflet-control-zoom-out:hover {
    background: #d3fa91 !important;
    border-color: #8fd14a !important;
  }
</style>

<div id="map"></div>
<div id="live-temp">Loading temperature...</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" client:load></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js" client:load></script>

<script client:load>
  const map = L.map("map").setView([38.716, -9.14], 13);

  L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
    attribution: "&copy; OpenStreetMap & CartoDB",
    maxZoom: 19
  }).addTo(map);

  const parksUrl =
    "https://services.arcgis.com/1dSrzEWVQn5kHHyK/arcgis/rest/services/POIArLivre/FeatureServer/0/query?outFields=*&where=1%3D1&f=geojson";

  function getRandomNoise() {
    return Math.floor(40 + Math.random() * 30);
  }
  function randomShade() {
    const levels = ["Low", "Medium", "High"];
    return levels[Math.floor(Math.random() * levels.length)];
  }
  function randomTables() {
    return Math.random() > 0.5 ? "Yes" : "No";
  }

  const heatPoints = [];

  const customIcon = L.icon({
    iconUrl: "mapPhotos/pinned.png",
    iconSize: [32, 32],
    iconAnchor: [16, 32],
    popupAnchor: [0, -32]
  });

  fetch(parksUrl)
    .then((res) => res.json())
    .then((geojson) => {
      L.geoJSON(geojson, {
        style: {
          color: "#006400",
          weight: 1.2,
          fillColor: "#00aa44",
          fillOpacity: 0.6
        },
        pointToLayer: (feature, latlng) =>
          L.marker(latlng, { icon: customIcon }),
        onEachFeature: (feature, layer) => {
          const props = feature.properties || {};
          const parkName =
            props.NOME || props.nome || props.name || "Unknown park";
          const noise = getRandomNoise();
          const shade = randomShade();
          const tables = randomTables();

          layer.bindPopup(`
<strong style="display:block; text-align:right;">${parkName}</strong><br>
<div style="display:flex;align-items:center;margin-bottom:0.5em;">
  <img src="mapPhotos/noise.png" style="height:2em;">
  <span style="margin-left:0.7em;flex:1;text-align:right;">Noise level: ${noise} dB</span>
</div>
<div style="display:flex;align-items:center;margin-bottom:0.5em;">
  <img src="mapPhotos/shadow.png" style="height:2em;">
  <span style="margin-left:0.7em;flex:1;text-align:right;">Shade: ${shade}</span>
</div>
<div style="display:flex;align-items:center;">
  <img src="mapPhotos/bench.png" style="height:2em;">
  <span style="margin-left:0.7em;flex:1;text-align:right;">Tables: ${tables}</span>
</div>
`);

          const coords = feature.geometry.coordinates;
          const temperature = 20 + Math.random() * 15;
          const intensity = (temperature - 20) / 15;
          heatPoints.push([coords[1], coords[0], intensity]);
        }
      }).addTo(map);

      L.heatLayer(heatPoints, {
        radius: 55,
        blur: 15,
        maxZoom: 17,
        gradient: { 0.0: "blue", 0.5: "lime", 1.0: "red" }
      }).addTo(map);
    });

  function updateLiveTemp() {
    fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=38.716&longitude=-9.14&current_weather=true"
    )
      .then((res) => res.json())
      .then((data) => {
        const w = data.current_weather;
        if (!w) {
          document.getElementById("live-temp").textContent =
            "Weather unavailable";
          return;
        }

        const temp = w.temperature;

        const rainCodes = [51, 53, 55, 61, 63, 65, 80, 81, 82];
        const isRaining = rainCodes.includes(w.weathercode);

        let icon = isRaining ? "rain" : "sun";
        let text = isRaining ? "Rain" : "Sunny";

        document.getElementById("live-temp").innerHTML = `
<span style="display:flex;align-items:center;">
  <img src="mapPhotos/hjem.png" style="height:1.3em;margin-right:0.5em;">
  <span style="flex:1;text-align:right;">Lisbon</span>
</span><br>
<span style="display:flex;align-items:center;">
  <img src="mapPhotos/temp.png" style="height:1.3em;margin-right:0.5em;">
  <span style="flex:1;text-align:right;">${temp.toFixed(1)}°C</span>
</span><br>
<span style="display:flex;align-items:center;">
  <img src="mapPhotos/${icon}.png" style="height:1.3em;margin-right:0.5em;">
  <span style="flex:1;text-align:right;">${text}</span>
</span>
`;
      });
  }

  updateLiveTemp();
  setInterval(updateLiveTemp, 60000);
</script>
