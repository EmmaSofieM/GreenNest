---
import LiveMap from './LiveMap.astro';
---

<section class="section-three">
  <div class="section-three__overlay">
    <h2>
      Discover Lisbon’s parks <br />
      and match them with <br />
      your needs.
    </h2>

    <div class="section-three__map">
      <div class="livemap-embed"><LiveMap /></div>
    </div>

    <div class="section-three__bottom">
    <p> Take a moment to explore the map and discover a park close to you — a place to bring your dog, read a book, meditate, or simply enjoy a quiet break in your day. </p> <p> This interactive map is here to support your well-being, so give yourself the time and space to find the spot that feels just right for you. </p>
      <a href="/map">
        <img src="/images/arrow4light.svg" alt="" class="section-three__arrow" />
      </a>
    </div>
  </div>

  <div class="section-three__image"></div>
</section>

<style>
/* --- SECTION 3 --- */

  :root {
    --map-max-width: 1200px;
    --map-height: 40vh;
  }

/* hover-effekt: ryk ikonet lidt til højre */
.section-three__arrow:hover {
  transform: translateX(8px);
}
.section-three {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 100vh;
  overflow: hidden;
}

/* husk at skifte */
.section-three__image {
  background: url("public/images/11.png") center/cover no-repeat;
  filter: brightness(0.75);
  display: block;
}

/* LEFT SIDE OVERLAY BOX */
.section-three__overlay {
  background: rgba(18, 40, 17, 0.92);
  padding: 4rem 5rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.section-three__overlay h2 {
  color: #d8ffb2;
  font-size: 3.2rem;
  font-weight: 600;
  line-height: 1.2;
}

/* MAP BOX */
.section-three__map {
  width: 100%;
  overflow: hidden;
  display: block;
}

/* ensure the embedded LiveMap fills the map box without changing layout */
.section-three__map .livemap-embed {
  width: 100%;
  display: block;
}

/* override inner LiveMap wrapper so it doesn't add extra margins or its own height */
.section-three__map .livemap-embed .map-wrap {
  margin: 0;
  max-width: none;
  box-shadow: none;
  display: block;
}

/* ensure the leaflet map element stretches to container height */
.section-three__map .livemap-embed #map {
  width: 100%;
  display: block;
}

/* remove the img rule (keeps previous behaviour if image remains elsewhere) */
.section-three__map img { display: none; }

/* BOTTOM TEXT + ARROW */
.section-three__bottom {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 2rem;
  align-items: start;
  z-index: 1;
  margin-top: 60px;
}

.section-three__bottom p {
  color: #d8ffb2;
  font-size: 1rem;
  line-height: 1.45;
  display: inline-block;            /* allow transform on the paragraph */
  transition: transform 160ms ease; /* match arrow animation */
}

/* when user hovers the bottom area (or the arrow), move the text slightly */
.section-three__bottom:hover p {
    transform: translateX(8px);
  }

.section-three__arrow {
  width: 55px;
  height: auto;
  align-self: center;
  transition: transform 160ms ease; /* simpel hover-anim */
  display: block;
}

/* ---------- Responsive: Section 3 (mobile) ---------- */
@media (max-width: 900px) {
    .section-three__image {
  background: url("public/images/11.png") center/cover no-repeat;
  filter: brightness(0.75);
  display: none;
}
    .section-three {
      grid-template-columns: 1fr; /* stack columns */
      height: auto;               /* allow section to shrink to content */
    }

     .section-three {
      grid-template-columns: 1fr; /* stack columns */
      height: auto;               /* allow section to shrink to content */
    }

    /* overlay (left) becomes first, full width */
    .section-three__overlay {
      padding: 2rem;
      order: 1;
      min-height: 0; /* allow overlay content to scroll inside if needed */
      overflow: visible;
    }

    /* map becomes second, set a fixed viewport height so it doesn't push layout */
    .section-three__map {
      order: 2;
      height: 55vh;
      min-height: 320px;
      overflow: hidden;
    }

    /* make sure embedded LiveMap fills its container */
    .section-three__map .livemap-embed,
    .section-three__map .livemap-embed .map-wrap,
    .section-three__map .livemap-embed #map {
      width: 100%;
      height: 100%;
      max-width: 100%;
    }
      @media (max-width: 900px) {
    :root { --map-height: 55vh; }
    #live-temp { right: 8px; left: auto; top: 8px; font-size:0.85rem; min-width: 200px; }
    .map-wrap { margin: 20px 12px; }
  }
   
  }

  @media (max-width: 580px) {
    .section-three__overlay {
      padding: 1.25rem;
    }

    .section-three__overlay h2 {
      font-size: 40px; /* smaller heading for small screens */
      line-height: 1.15;
    }

    .section-three__map {
      height: 44vh;   /* slightly smaller on small phones */
      min-height: 240px;
    }
    .section-three__map .livemap-embed #map {
      height: 100%;
    }
  }
</style>