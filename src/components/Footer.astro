<script>
  // inline confirmation for footer arrow button (shows like send button)
  (function () {
    const btn = document.querySelector('.input-wrapper .footer-arrow-btn');
    const confirm = document.querySelector('.input-wrapper .footer-confirm');
    if (!btn || !confirm) return;
    let timeoutId = null;

    function hide() {
      confirm.classList.remove('show');
      confirm.setAttribute('aria-hidden', 'true');
      if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      confirm.classList.add('show');
      confirm.setAttribute('aria-hidden', 'false');
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(hide, 3000);

      // hide when clicking anywhere else (one-time listener)
      const onDocClick = (ev) => {
        if (ev.target === btn || btn.contains(ev.target)) return;
        hide();
        document.removeEventListener('click', onDocClick);
      };
      setTimeout(() => document.addEventListener('click', onDocClick), 0);
    });
  })();
</script>

