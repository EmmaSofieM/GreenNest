    <style>
      body {
        margin: 0;
        background-color: #FAFCF7;
        color: #122D12;
      }

      footer {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 40px;
        padding: 80px 160px 40px;
        background-color: #f9faf5;
        border-top: 1px solid #d8dccf;
        position: relative;
      }

      /* --- Left section --- */
      .footer-signup h2 {
        font-size: 31px; /* 26 + 5px */
        font-weight: 700;
        margin: 0 0 10px;
      }

      .footer-signup p {
        font-size: 23px; /* 18 + 5px */
        margin: 0 0 12px;
      }

      .footer-signup input {
        width: 100%;
        padding: 10px;
        border: none;
        border-bottom: 1px solid #2f3b27;
        background-color: transparent;
        font-size: 21px; /* 16 + 5px */
        color: #2f3b27;
        outline: none;
      }

      .footer-signup input::placeholder {
        color: #2f3b27;
        opacity: 0.7;
      }


      /* --- Contact section --- */
      .footer-signup p {
        font-size: 21px; /* 16 + 5px (contact text) */
        line-height: 1.5;
      }

      .footer-signup a {
        font-size: 21px; /* 16 + 5px */
        font-weight: 700;
        margin-bottom: 10px;
      }
      .footer-signup img,
      .footer-signup svg {
        vertical-align: middle;
        margin-right: 8px;
      }

      .footer-signup a {
        text-decoration: none;
        color: #2f3b27;
        display: block;
        margin: 6px 0;
        font-size: 21px; /* 16 + 5px */
      }

      /* --- Credits section --- */
      .footer-credits h3 {
        font-size: 21px; /* 16 + 5px */
        font-weight: 700;
        margin-bottom: 8px;
      }

      .footer-credits p {
        margin: 6px 0;
        font-size: 20px; /* 15 + 5px */
      }


      /* --- Links section --- */
      .footer-links h3 {
        font-size: 21px; /* 16 + 5px */
        font-weight: 700;
        text-align: end;
      }

      .footer-links a {
        text-align: end;
        padding-right: -20px; /* plads til pilen */
        display: block;
        text-decoration: none;
        color: #2f3b27;
        margin: 7px 0;
        font-size: 21px; /* 16 + 5px */
      }

      /* --- Bottom logo --- */
      .footer-logo {
        /* placer i den sidste kolonne via grid (juster hvis du vil den skal spanning) */
        grid-column: 3;
        align-self: end;
        justify-self: end;
        margin-top: 40px;
        text-align: right;
        position: static;
        padding: 0;
      }

      .footer-logo img {
        max-width: 600px; /* juster efter ønsket størrelse */
        width: 100%;
        height: auto;
        display: inline-block;
      }

      /* --- Back to top --- */
      .footer-top {
        position: absolute;
        bottom: 30px;
        left: 60px;
        font-size: 21px; /* 16 + 5px */
        color: #2f3b27;
        text-decoration: none;
      }

    .footer-arrow {
  width: 14px;              /* størrelse på pilen */
  height: 14px;
  vertical-align: middle;   /* sikrer den står på linje med teksten */
  display: inline-block;    /* nødvendigt for vert-align at virke */
  transition: transform 0.2s ease;
}

/* valgfri hover-effekt */
.footer-links a:hover .footer-arrow {
  transform: translateX(3px);
}

.go-up {
padding-top: 30px;
  display: inline-flex;      /* inline-flex for to stå på linje med tekst */
  align-items: center;       /* vertikalt centreret */
  text-decoration: none;
  color: inherit;
    animation: bounce 1s infinite; /* animation på pilen */

}

/* ensure footer arrow used inside input can be clicked (we will use button) */
.input-wrapper {
  position: relative;        /* holder confirm-teksten i flowet */
  display: block;
  width: 100%;               /* fylder hele formular-bredden */
  padding-bottom: 8px;       /* lidt plads til confirm-teksten under */
}

/* ny: input og knap på samme linje */
.input-row {
    display: flex;
    gap: 6px;              /* mindre mellemrum så knappen rykkes tættere på input */
    align-items: center;
    width: 100%;
  }

  .input-row input {
    flex: 1;
    padding: 10px;
    box-sizing: border-box;
  }

  /* placér knappen i flowet til højre for input */
  .input-wrapper .footer-arrow-btn {
    position: static;
    right: auto;
    top: auto;
    transform: none;
    background: transparent;
    border: none;
    padding: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: -30px;     /* flyt knappen lidt til venstre; juster -8px efter behov */
  }

/* lille visuelt tweak så knappen ligner links på hover */
.input-wrapper .footer-arrow-btn:hover img {
    transform: translateX(3px);
  }

/* fjern absolute-styling fra input (hvis tidligere sat) */
.input-wrapper input {
    padding-right: 12px;
  }

/* keep visual arrow size */
.input-wrapper .footer-arrow-btn img,
.footer-links img.footer-arrow,
.go-up img.footer-arrow  {
  width: 16px;
  height: 16px;
  display: inline-block;
  vertical-align: middle;
}
 
/* same hover motion as links */
.input-wrapper .footer-arrow-btn:hover img,
.footer-links a:hover .footer-arrow {
  transform: translateX(3px);
}
 
/* confirmation text shown below the input */
.input-wrapper .footer-confirm {
  position: static;          /* vises i dokumentflow under input */
  display: block;
  margin-top: 8px;
  transform: translateY(6px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease, transform 220ms ease;
  font-weight: 700;
  color: #122D12;
  white-space: nowrap;
  font-size: 16px;
  text-align: left;
}
.input-wrapper .footer-confirm.show {
  opacity: 1;
  transform: translateY(0);
}

.connect {
  font-family: "Nimbus Sans D OT Bold", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-3px); /* hvor meget den hopper */
  }
}

.footer-contact a {
  display: inline-flex;       /* gør teksten og ikonet på linje */
  align-items: center;        /* vertikalt centreret */
  text-decoration: none;
  color: inherit;
  margin-bottom: 5px;         /* lidt afstand mellem links */
}

.contact-icon {
  width: 25px;               /* samme størrelse som pilene */
  height: 24px;
  margin-right: 5px;         /* afstand mellem ikon og tekst */
  display: inline-block;
  vertical-align: middle;    /* fallback hvis inline-flex ikke virker */
}

.padding {
    padding: 50px;
}
.footer-logo-wrapper {
  width: 100%;
  text-align: end;
  margin-top: 40px;
}

.footer-logo-wrapper img {
  height: auto;
  width: 1000px;
  right: 0px;
  position: absolute;
  bottom: 85px;
}



      @media (max-width: 768px) {
        footer {
          padding: 60px 30px;
          text-align: left;
        }

        .footer-logo img {
          max-width: 300px;
          width: 70%;
        }

        .footer-top {
          left: 30px;
        }

        /* ensure the inline confirm sits nicely on small screens */
        .input-wrapper .footer-confirm { display: none; }
      }
    </style>

