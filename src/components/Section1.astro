---
--- 

<section class="section1">
  <div class="inner">
    <h1>Discover Lisbon’s most peaceful parks<br/>and see how green spaces can improve mental health.</h1>

    <img src="/images/unity.png" alt="Parks in Lisbon" class="section1-image" />

    <div class="section1-text">
      <a class="cta-link" href="/app" target="_blank" rel="noopener noreferrer">
        <h2>Try our app and be aware <br> how it improves your mental health</h2>
        <img src="/images/touch.svg" alt="touch" class="cta-image" />
      </a>
    </div>
  </div>
</section>

<style>
  :root {
    --content-width: 1300px;
    --cta-offset: 20px;
    --cta-size: 150px;
  }

  .section1 {
    margin: 100px 0;
  }

  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .inner h1 {
    margin: 0 0 16px 0;
    text-align: left;
    font-size: 45px;
    line-height: 1.15;
  }

  .section1-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 24px 0 0 0;
    max-width: 100%;
  }

  .section1-text {
    display: flex;
    margin-top: 80px;
    justify-content: flex-end;
  }

  .cta-link {
    display: flex;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .cta-image {
    flex: 0 0 var(--cta-size);
    width: var(--cta-size);
    height: auto;
    display: block;
    align-self: center;
    transition: transform 360ms ease;
  }

  .cta-link:hover .cta-image {
    transform: translateX(8px);
  }

  h2 {
    margin-top: 25px;
  }

  /* ---------- Responsive ---------- */

  /* tablet-ish */
  @media (max-width: 900px) {
    :root { --content-width: 760px; --cta-size: 120px; --cta-offset: 12px; }
    .inner h1 {
      font-size: 32px;
      line-height: 1.12;
      text-align: left;
    }
    .section1-text {
      margin-top: 40px;
      justify-content: flex-end;
    }
    .section1-image {
      margin-top: 20px;
    }
    .section1-text h2 {
      font-size: 20px;
      max-width: calc(100% - var(--cta-size) - var(--cta-offset) - 8px);
    }
    .cta-image { width: var(--cta-size); }
  }

  /* mobile: keep colors/borders intact, only responsive layout changes */
  @media (max-width: 580px) {
    :root { --content-width: 100%; --cta-size: 56px; --cta-offset: 12px; }

    .section1 {
      margin: 48px 0;
    }

    .inner {
      padding: 0 18px;
    }

    /* make heading compact and centered on small screens */
    .inner h1 {
      font-size: 32px;
      line-height: 1.18;
      text-align: start;
      margin-bottom: 12px;
    }

    /* limit image height so it doesn't push layout (keeps aspect) */
    .section1-image {
      margin: 12px 0;
      width: 100%;
      max-height: 38vh;
      object-fit: cover;
      border-radius: 6px;
    }

    /* stack CTA under heading, full width but keep original colors */
    .section1-text {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      margin-top: 18px;
      gap: 10px;
    }

    .cta-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      padding: 12px 16px;
      border-radius: 10px;
      text-decoration: none;
      /* DO NOT change colors/borders — keep inherited color */
    }

    .cta-link h2 {
      margin: 0;
      font-size: 20px;
      line-height: 1.2;
      font-weight: 600;
      text-align: left;
    }

    .cta-image {
      width: var(--cta-size);
      height: auto;
      margin-top: 0;
      transform: none;
    }

    /* keep spacing after the section consistent */
    .section1-text + * { margin-top: 12px; }
  }
</style>