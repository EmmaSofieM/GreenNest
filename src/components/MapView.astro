import LiveMap from './LiveMap.astro';
--- 

<section class="about-hero">
  <div class="about-hero__content">
    <button class="about-hero__back" type="button" onclick="history.back()">← Go back</button>
    <h1 class="about-hero__title">Find the perfect park for you</h1>
  </div>

</section>

<LiveMap clie/>
<!-- NYT: to tekst-kolonner under hero -->
<section class="about-columns">
  <div class="col">
    <h2>Why a Park Matters</h2>
   </p>Sometimes your mind just needs a quieter place. Green spaces lower stress, reduce noise, and give your brain a moment to breathe. Even a short walk or ten minutes on a bench can reset your focus and lift your mood.</p>
  </div>

  <div class="col">
    <h2>Nature Helps More Than You Think</h2>
    <p>When you step into a park, the air, the sounds, and the atmosphere change instantly. Trees cool the city, birds soften the noise, and the environment slows you down. These small moments of calm support your mental well-being more than you may realize.</p>
  </div>
</section>

<style>
  .about-hero {
    display: flex;
    align-items: flex-start; /* flyt indhold til toppen i stedet for centreret */
    gap: 28px;
    max-width: 1200px;
    margin: 140px auto 0; /* rykket længere ned */
  }

  .about-hero__title {
    margin: 0 0 12px; /* fjern den store top-margin */
    font-size: 36px;
    line-height: 1.08;
  }

  .about-hero__lead{
    margin: 0;
    font-size: 18px;
    line-height: 1.45;
    color: #2f4b35;
  }

  .about-hero__back{
    background: transparent;
    border: none;
    color: #122d12;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 0;
    font-size: 15px;
  }

  .about-hero__back:hover{
    transform: translateX(-6px);
    transition: transform 160ms ease;
  }

  .about-hero__visual{
    flex: 0 0 48%;
    display: flex;
    justify-content: flex-end;
  }

  .about-hero__visual img{
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
  }
    .about-columns{
    max-width: 1150px;
    margin: 120px auto 80px; /* rykket lidt længere ned så sektioner følger hero */
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 120px;
    align-items: start;
  }

  .about-columns .col h1 {
    font-size: 22px;
    margin: 0 0 8px;
  }

  .about-columns .col h2 {
    font-size: 18px;
    margin: 0 0 10px;
    color: #2f4b35;
  }

  .about-columns .col p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #405035;
  }

  /* ---------- Mobile responsiveness (only affects <= 900px and smaller) ---------- */
  @media (max-width: 900px) {
    /* Stack hero content and visual, keep desktop rules untouched */
    .about-hero {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: 20px;
      margin: 80px auto; /* rykket ned på mobil */
      max-width: 92%;
    }

    .about-hero__content {
      width: 100%;
      padding: 0 8px;
    }

    .about-hero__title {
      font-size: 28px;
      line-height: 1.12;
      margin-bottom: 8px;
    }

    .about-hero__back {
      display: inline-block;
      margin-bottom: 6px;
    }

    /* Visual area / map: full width and responsive height */
    .about-hero__visual {
      width: 100%;
      flex: 0 0 auto;
      justify-content: center;
    }
    .about-hero__visual img {
      max-width: 100%;
      height: auto;
    }

    /* If LiveMap renders an element, ensure it fills width and reasonable height */
    LiveMap,
    live-map,
    .livemap-embed,
    .map-wrap,
    #map {
      display: block;
      width: 100% !important;
      max-width: 100% !important;
      height: 55vh !important; /* map visible but doesn't push content too far */
      min-height: 220px;
    }

    /* Columns under hero become a single column stack */
    .about-columns {
      grid-template-columns: 1fr;
      gap: 28px;
      margin: 60px 16px; /* skubbet ned under hero på mobil */
      max-width: 96%;
    }
    .about-columns .col h2 {
      font-size: 22px;
      text-align: left;
    }
    .about-columns .col p {
      font-size: 20px;
      line-height: 1.5;
    }
  }

  @media (max-width: 580px) {

  

   h1 {
    font-size: 5rem;
      text-align: start;
    }
    .about-hero {
      margin: 60px auto;
      gap: 12px;
    }
    .about-hero__title {
      font-size: 32px;
    text-align: start;

    }
    /* Slightly shorter map on small phones */
    LiveMap,
    live-map,
    .livemap-embed,
    .map-wrap,
    #map {
      height: 44vh !important;
      min-height: 180px;
    }
    .about-columns {
      margin: 40px 12px;
      gap: 18px;
    }
    .about-columns .col p { font-size: 20px; }
  }

  /* ...existing rules... */
</style>