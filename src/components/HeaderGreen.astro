<header class="site-header">
  <div class="logo">
    <a href="/" aria-label="Gå til forsiden">
      <img src="images/logogreen.png" alt="Green Nest Logo" class="logo-desktop" />
    </a>
    <a href="/" aria-label="Gå til forsiden">
      <img src="images/watermark.png" alt="Green Nest Watermark" class="logo-mobile" />
    </a>
  </div>

  <!-- burger is now created/removed by JS so it's not present in desktop DOM -->
  <template id="burgerTemplateGreen">
    <div class="burger" id="burgerGreen" aria-label="Menu" aria-expanded="false" role="button" tabindex="0">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </template>
  <div id="burgerContainerGreen" aria-hidden="true"></div>
  
  <nav id="mobileMenuGreen" aria-hidden="true">
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/map">Map</a>
    <a href="/experience">Experience</a>
  </nav>
</header>

<style>
  /* --- Base layout + green theme --- */
  body { margin: 0; background-color: #fafcf7; }

  .site-header a { color: #122D12; transition: color 0.3s ease; }
  .burger span { background-color: #122d12; transition: background-color 0.3s ease; }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    padding: 5px 30px;
    z-index: 1500;
    background-color: transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
      backdrop-filter: blur(100px);
    background-color: #fafcf7;
    border-color: #122d12;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .site-header.scrolled {
    backdrop-filter: blur(100px);
    background-color: #fafcf7;
    border-color: #122d12;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .logo { display:flex; align-items:center; }
  .logo img { height:50px; transition: opacity .3s ease; }
  .logo-desktop{ display:block } .logo-mobile{ display:none }

  nav { display:flex; gap:40px; }
  nav a { text-decoration:none; color:#122d12; font-size:18px; transition: color .2s ease; }
  nav a:hover { color:#5e7c3b; }

  .burger {
    display:none;
    position: relative;
    width:48px;
    height:36px;
    cursor:pointer;
    z-index:1100;
    padding:0;
    display:inline-block;
  }

  .burger span{
    position:absolute; left:6px; right:6px; height:3px;
    background-color:#122d12; border-radius:2px;
    transition: transform 260ms cubic-bezier(.2,.8,.2,1), opacity 200ms ease, top 260ms;
    transform-origin:center center; z-index:1100;
  }
  .burger span:nth-child(1){ top:25%; transform:translateY(-50%); }
  .burger span:nth-child(2){ top:50%; transform:translateY(-50%); }
  .burger span:nth-child(3){ top:75%; transform:translateY(-50%); }

  .burger.active span:nth-child(1){ top:50%; transform:translateY(-50%) rotate(45deg); }
  .burger.active span:nth-child(2){ opacity:0; transform:scaleX(0); }
  .burger.active span:nth-child(3){ top:50%; transform:translateY(-50%) rotate(-45deg); }

  @media (max-width:768px) {
    nav {
      flex-direction: column;
      position: absolute;
      top: 65px;
      right: 0;
      left: 0;
      height: calc(100vh - 65px);
      max-height: 0;
      overflow: hidden;
      align-items: center;
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      z-index: 999;
      transition: max-height 420ms ease;
      background: rgba(250,252,247,0.95);
    }
    nav.show { max-height: calc(100vh - 65px); }

    nav a {
      display:block;
      width:100%;
      padding:24px 40px;
      font-size:2rem;
      text-align:end;
      font-weight:600;
    }

    .burger {
      display:flex !important;
      position:absolute;
      right:20px;
      top:50%;
      transform:translateY(-50%);
      z-index:2200;
    }

    .logo-desktop{ display:none } .logo-mobile{ display:block }
  }
</style>

<script client:load type="text/javascript">
(() => {
  const menu = document.getElementById('mobileMenuGreen');
  const burgerContainer = document.getElementById('burgerContainerGreen');
  const burgerTemplate = document.getElementById('burgerTemplateGreen');
  if (!menu || !burgerContainer || !burgerTemplate) {
    console.warn('HeaderGreen: required elements not found', { menu: !!menu, burgerContainer: !!burgerContainer, burgerTemplate: !!burgerTemplate });
    return;
  }

  let lastTouch = 0;
  let handlersAttached = false;
  const MAX_HEIGHT = 'calc(100vh - 65px)';

  const openMenu = () => {
    menu.classList.add('show');
    menu.style.maxHeight = MAX_HEIGHT;
    const b = document.getElementById('burgerGreen');
    if (b) { b.classList.add('active'); b.setAttribute('aria-expanded','true'); }
    menu.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    menu.classList.remove('show');
    menu.style.maxHeight = '0';
    const b = document.getElementById('burgerGreen');
    if (b) { b.classList.remove('active'); b.setAttribute('aria-expanded','false'); }
    menu.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  };

  const toggleMenu = () => { menu.classList.contains('show') ? closeMenu() : openMenu(); };

  function onDocumentClick(e) {
    const clickedBurger = !!(e.target && e.target.closest && e.target.closest('#burgerGreen'));
    if (clickedBurger) {
      if (Date.now() - lastTouch < 700) return;
      toggleMenu();
      return;
    }
    if (menu.classList.contains('show')) {
      const b = document.getElementById('burgerGreen');
      if (b && (b.contains(e.target) || menu.contains(e.target))) return;
      closeMenu();
    }
  }

  function onDocumentTouchEnd(e) {
    const clickedBurger = !!(e.target && e.target.closest && e.target.closest('#burgerGreen'));
    if (clickedBurger) {
      lastTouch = Date.now();
      e.preventDefault?.();
      toggleMenu();
    }
  }

  function onDocumentKey(e) {
    const b = document.getElementById('burgerGreen');
    if (!b) return;
    if (document.activeElement === b && (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar')) {
      e.preventDefault();
      toggleMenu();
    }
  }

  function attachHandlers() {
    if (handlersAttached) return;
    document.addEventListener('click', onDocumentClick);
    document.addEventListener('touchend', onDocumentTouchEnd, { passive: false });
    document.addEventListener('keydown', onDocumentKey);
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    handlersAttached = true;
  }

  function detachHandlers() {
    if (!handlersAttached) return;
    document.removeEventListener('click', onDocumentClick);
    document.removeEventListener('touchend', onDocumentTouchEnd);
    document.removeEventListener('keydown', onDocumentKey);
    handlersAttached = false;
  }

  function createBurger() {
    if (burgerContainer.querySelector('#burgerGreen')) return;
    const clone = burgerTemplate.content.cloneNode(true);
    burgerContainer.appendChild(clone);
    burgerContainer.setAttribute('aria-hidden','false');
    attachHandlers();
  }

  function removeBurger() {
    closeMenu();
    detachHandlers();
    burgerContainer.innerHTML = '';
    burgerContainer.setAttribute('aria-hidden','true');
  }

  function sync() {
    const isMobile = window.innerWidth <= 768;
    if (isMobile) createBurger();
    else removeBurger();
  }

  sync();
  window.addEventListener('resize', () => {
    sync();
    if (window.innerWidth > 768 && menu.classList.contains('show')) closeMenu();
  });
  window.addEventListener('beforeunload', closeMenu);
})();
</script>
