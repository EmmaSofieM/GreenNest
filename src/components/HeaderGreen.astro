<header class="site-header">
  <div class="logo">
    <a href="/" aria-label="Gå til forsiden">
      <img src="/images/logogreen.png" alt="Green Nest Logo" class="logo-desktop" />
    </a>
    <a href="/" aria-label="Gå til forsiden">
      <img src="/images/watermark.png" alt="Green Nest Watermark" class="logo-mobile" />
    </a>
  </div>

  <div class="burger" id="burger" aria-label="Menu" aria-expanded="false" role="button">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <nav id="mobileMenu" aria-hidden="true">
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/map">Map</a>
  </nav>
</header>

<style>
  /* --- Base layout --- */
  body {
    margin: 0;
    background-color: #fafcf7;
  }
/* Farveskift på tekst og burger */
.site-header a {
  color: #122d12; /* lys grøn */
  transition: color 0.3s ease;

  
}

.burger span {
  background-color: #122d12; /* lys grøn burger */
  transition: background-color 0.3s ease;
}

.site-header.scrolled a {
  color: #122d12; /* mørkegrøn */
}

.site-header.scrolled .burger span {
  background-color: #122d12;
}

  /* ✅ NYT: Scrollbar fixet header */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed; /* Gør den fast øverst */
    top: 0;
    left: 0;
    width: 100%;
    padding: 5px 30px;
    z-index: 100;
 
  }

  /* ✅ NYT: Når man scroller forbi hero */
  .site-header {
    backdrop-filter: blur(10px);
    background-color: #fafcf797;
  }

  /* --- Logo --- */
  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 50px;
    transition: opacity 0.3s ease;
  }

  /* --- Two logos (only one visible depending on screen size) --- */
  .logo-desktop {
    display: block;
  }

  .logo-mobile {
    display: none;
  }

  /* --- Navigation (desktop) --- */
  nav {
    display: flex;
    gap: 40px;

  }

  nav a {
    text-decoration: none;
    color: #122d12;
    font-size: 18px;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #5e7c3b;
  }

  /* --- Burger icon --- */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 25px;
    height: 18px;
    cursor: pointer;
    z-index: 1100;
        z-index: 1100;

  }

  .burger span {
    height: 3px;
    width: 100%;
    background-color: #d3fa91;
    border-radius: 2px;
    transition: all 0.3s ease;
    z-index: 1100;
  }

  /* --- Animation for burger toggle --- */
  .burger.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .burger.active span:nth-child(2) {
    opacity: 0;
  }

  .burger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* --- Mobile nav (hidden by default) --- */
  @media (max-width: 768px) {
    nav {
      flex-direction: column;
      position: absolute;
      top: 65px;
      right: 0;
      left: 0;
      /* Fyld hele viewport fra under header og ned til bunden */
      height: calc(100vh - 65px);
      max-height: 0;
      overflow: hidden;
      align-items: center;
      /* Glas-effekt: semitransparent baggrund + backdrop-filter */
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      z-index: 999; /* sikre at menuen ligger over indhold */
      transition: max-height 1.35s ease;
    }
  
    nav.show {
      /* Når åben: vis hele menu-området (ned til bunden) */
      max-height: calc(100vh - 65px);
    }
  
    nav a {
      display: block;
      width: 100%;
      padding: 14px 20px;
      font-size: 20px;
      text-align: center;
    }
  
    .burger {
      display: flex;
      z-index: 2100;
    }
  
    /* Swap logos on mobile */
    .logo-desktop {
      display: none;
    }
  
    .logo-mobile {
      display: block;
    }
  }
</style>

<script type="text/javascript">
document.addEventListener("DOMContentLoaded", () => {
  const menu = document.getElementById("mobileMenu");
  const burger = document.getElementById("burger");
  if (!menu || !burger) return;

  // Ensure closed on load
  menu.classList.remove("show");
  burger.classList.remove("active");
  burger.setAttribute("aria-expanded", "false");
  menu.setAttribute("aria-hidden", "true");
  document.body.style.overflow = "";

  const openMenu = () => {
    menu.classList.add("show");
    burger.classList.add("active");
    burger.setAttribute("aria-expanded", "true");
    menu.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  };

  const closeMenu = () => {
    menu.classList.remove("show");
    burger.classList.remove("active");
    burger.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  burger.addEventListener("click", () => {
    menu.classList.contains("show") ? closeMenu() : openMenu();
  });

  // Luk ved klik på link eller klik udenfor, samt ved resize > breakpoint
  menu.querySelectorAll("a").forEach(a => a.addEventListener("click", closeMenu));
  document.addEventListener("click", (e) => {
    if (!menu.classList.contains("show")) return;
    if (burger.contains(e.target) || menu.contains(e.target)) return;
    closeMenu();
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 768 && menu.classList.contains("show")) closeMenu();
  });
});
</script>
